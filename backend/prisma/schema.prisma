generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Users of the clinic (Doctor, Receptionist, Admin)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Doctor") // Admin, Doctor, Receptionist
  createdAt DateTime @default(now())
}

// Patients visiting the clinic
model Patient {
  id          String   @id @default(uuid())
  name        String
  age         Int
  gender      String?
  contact     String
  address     String?
  medicalHist Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  prescriptions Prescription[]
  bills         Billing[]
  followUps     FollowUp[]
}

// Medicine stock inventory
model Inventory {
  id                String   @id @default(uuid())
  medicineName      String
  brand             String?
  formulation       String?       // Tablet, Powder, Liquid, Avaleha, etc.
  stockQuantity     Int
  unit              String?       // Bottles, Jars, Strips, etc.
  price             Float
  expiryDate        String?       // Stored as "YYYY-MM" string
  lowStockThreshold Int      @default(20)
  createdAt         DateTime @default(now())
}

// Patient Appointments
model Appointment {
  id        String   @id @default(uuid())
  patientId String
  date      DateTime
  time      String?                        // e.g. "09:00 AM"
  type      String   @default("New Consult") // New Consult, Follow Up, Prakriti Parikshan, Nadi Pariksha
  status    String   @default("Scheduled")  // Scheduled, Waiting, Consulting, Completed, Cancelled, Rescheduled
  token     Int?
  notes     String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Prescriptions for a patient
model Prescription {
  id        String   @id @default(uuid())
  patientId String
  diagnosis String?
  medicines Json     // Array of { name, timing, anupan, days }
  pathya    String?
  apathya   String?
  notes     String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Billing & Invoices
model Billing {
  id          String   @id @default(uuid())
  patientId   String
  invoiceNo   String   @unique
  totalAmount Float
  paidStatus  Boolean  @default(false)
  billType    String?  // Consultation, Medicines, Panchakarma, etc.
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Patient Follow-up reminders
model FollowUp {
  id        String   @id @default(uuid())
  patientId String
  diagnosis String?
  dueDate   DateTime
  status    String   @default("Scheduled") // Scheduled, Pending, Called, Overdue
  notes     String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Ayurvedic Disease Protocols (auto-suggest medicines for a diagnosis)
model DiseaseProtocol {
  id              String   @id @default(uuid())
  name            String   @unique
  type            String?  // Digestive, Musculoskeletal, Metabolic, Respiratory, etc.
  mainDosha       String?  // Vata, Pitta, Kapha, Kapha-Vata, etc.
  commonMedicines Json     // Array of medicine name strings
  pathya          String?
  apathya         String?
  createdAt       DateTime @default(now())
}
