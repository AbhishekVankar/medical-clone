# Copy this file to .env and fill in your values

# ---------------------------------------------------------------
# FOR NEON (Cloud PostgreSQL) — Get both URLs from Neon dashboard
# ---------------------------------------------------------------
# Pooled connection URL (used by the app at runtime)
DATABASE_URL="postgresql://neondb_owner:npg_UajwcNyp19Fv@ep-billowing-fog-anmvvzfz-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (non-pooled) connection URL (used by Prisma for migrations)
# Same as above but WITHOUT ".pooler." in the hostname
DIRECT_URL="postgresql://neondb_owner:npg_UajwcNyp19Fv@ep-billowing-fog-anmvvzfz.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------
# FOR LOCAL PostgreSQL (if running on your own PC)
# ---------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ayurclinic"
# DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/ayurclinic"

# ---------------------------------------------------------------
# JWT secret — any long random string (min 32 characters)
# ---------------------------------------------------------------
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Server port (optional, defaults to 5000)
PORT=5000
